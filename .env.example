# Crown Town Compost customer-portal credentials (portal.crowntowncompost.com)
CROWNTOWN_USERNAME=you@example.com
CROWNTOWN_PASSWORD=your-portal-password

# Alternative to the pair above: a Cookie header from an already signed-in
# portal session. Supply this and no password is needed.
# CROWNTOWN_SESSION_COOKIE=sessionid=...; csrftoken=...
