{
  "mcpServers": {
    "crowntowncompost": {
      "command": "npx",
      "args": [
        "-y",
        "crowntowncompost-mcp"
      ],
      "env": {
        "CROWNTOWN_SESSION_COOKIE": "${CROWNTOWN_SESSION_COOKIE}",
        "CROWNTOWN_USERNAME": "${CROWNTOWN_USERNAME}",
        "CROWNTOWN_PASSWORD": "${CROWNTOWN_PASSWORD}"
      }
    }
  }
}
