{
  "name": "crowntowncompost-mcp",
  "version": "1.0.1",
  "mcpName": "io.github.chrischall/crowntowncompost-mcp",
  "description": "Crown Town Compost customer-portal MCP server for Claude — developed and maintained by AI (Claude Code)",
  "author": "Claude Code (AI) <https://www.anthropic.com/claude>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischall/crowntowncompost-mcp.git"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai",
    "crowntown",
    "compost",
    "stopsuite",
    "curbside"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "crowntowncompost-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    ".claude-plugin",
    "skills",
    ".mcp.json",
    "server.json",
    "manifest.json",
    "mint.yaml"
  ],
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --alias:zod/v4=./node_modules/zod/v4/index.cjs --platform=node --format=esm --external:dotenv --outfile=dist/bundle.js",
    "dev": "node dist/index.js",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run typecheck && vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chrischall/mcp-utils": "^2.4.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "dotenv": "^17.4.0",
    "node-html-parser": "^9.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
